<tm:xmi/EAID_712E17BF_99E5_419d_91FE_0C1FDA4C06D6> a tm:Class ;
    rdfs:label "FLEXIBLE LINK PROPERTIES" ;
    skos:definition "Set of properties describing the flexible characteristics of a LINK. A composition is used with LINK in order to avoid multiple inheritance and a type explosion of link subtypes Notes: Type of FLEXIBLE ROUTE LINK. Notes: Identifier of a FLEXIBLE LINK PROPERTIES. Notes: Whether the LINK may be skipped. Notes: Whether the LINK is on the main ROUTE of the LINE. Notes: Whether the connection with the road infrastructure is not defined." ;
    tm:attribute <tm:xmi/EAID_712E17BF_99E5_419d_91FE_0C1FDA4C06D6/attribute/EAID_1A021B69_F59A_4320_84D6_CD1EA5ED70F7>,
