<tm:xmi/EAID_99989F6B_4486_4d3e_92A5_89247BC9708F> a tm:Class ;
    rdfs:label "FLEXIBLE STOP PLACE" ;
    rdfs:subClassOf <tm:xmi/EAID_06B01244_7E43_4925_8610_0B0B61508E7D> ;
    skos:definition "A specialisation of the STOP PLACE describing a stop of a FLEXIBLE SERVICE. It may be composed of FLEXIBLE AREAs or HAIL AND RIDE AREAs identifying the catchment areas for flexible services (when they use areas or flexible quays). Some FLEXIBLE SERVICE also use regular STOP PLACEs for their stops. When assigned to a SCHEDULED STOP POINT the corresponding SCHEDULED STOP POINT is supposed to be a ZONE (the centroid point of the ZONE being the SCHEDULED STOP POINT). Notes: Identifier of a FLEXIBLE STOP PLACE. Notes: Locale setting time zone, default language etc, for the FLEXIBLE STOP PLACE. Notes: Suffix to use on Name." ;
    tm:attribute <tm:xmi/EAID_99989F6B_4486_4d3e_92A5_89247BC9708F/attribute/EAID_042C8F9E_C0C4_443a_894E_75D2AC737EE4>,
