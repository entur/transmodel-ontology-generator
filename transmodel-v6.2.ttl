<tm:xmi/EAID_77A46C50_6368_485f_931F_5629F348C91F> a tm:Class ;
    rdfs:label "PROPERTY OF DAY" ;
    skos:definition "A property which a day may possess, such as school holiday, weekday, summer, winter etc. Notes: For those day types that occur on the same day every year, month and day, assigned to PROPERTY OF DAY. Notes: Description of PROPERTY OF DAY. Notes: Country of Holiday type assigned to PROPERTY OF DAY. Notes: Holiday type assigned to PROPERTY OF DAY. Notes: Identifier of PROPERTY OF DAY. Notes: Name of PROPERTY OF DAY. Notes: Season of year assigned to PROPERTY OF DAY. Notes: State of tide assigned to PROPERTY OF DAY. Notes: Weeks of month (1-5) assigned to PROPERTY OF DAY." ;
    tm:attribute <tm:xmi/EAID_77A46C50_6368_485f_931F_5629F348C91F/attribute/EAID_0A48CD43_DEBE_460a_9AFD_DE93CF9EBEE5>,
