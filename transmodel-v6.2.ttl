    tm:xmiId "EAID_1EE9500C_74ED_4ee2_A433_BE4862D5D041" .

<tm:xmi/EAID_2E027A4A_3620_4958_905D_DF4009150B1B> a tm:Class ;
    rdfs:label "TRAVEL DOCUMENT" ;
    skos:definition "A particular physical evidence to be held by a passenger, (ticket, card, etc..) allowing the determination of the right to travel or to consume joint-services. May comprise just a token associated with an online account, or some form of representation of the access rights. Notes: Whether the TRAVEL DOCUMENT is currently deemed active. Notes: Description of TYPE OF TRAVEL DOCUMENT. Notes: Identifier of TRAVEL DOCUMENT. Notes: Secure token used to identify customer, May be anonymised. Notes: Name of TYPE OF TRAVEL DOCUMENT." ;
