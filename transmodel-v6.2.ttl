    tm:module "part-1-common-concepts-cc" ;
    tm:packagePath "Transmodel v6.2  2024 / Part 1 - Common Concepts (CC) / CG Generic Framework MODELs / CG Generic View MODEL" ;
    tm:xmiId "EAID_8E1FC557_3DAB_4b8d_A851_20B17B4CA37F" .

