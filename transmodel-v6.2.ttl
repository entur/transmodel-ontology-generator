<tm:xmi/EAID_7145E6DD_1631_4e6f_8E7D_C59D76528EE7> a tm:Class ;
    rdfs:label "navigation path" ;
    skos:definition "A designated path between two places. May include an ordered sequence of PATH LINKs. Notes: Type of an ACCESS Feature. Notes: ACCESSIBILITY ASSESSMENT associated with NAVIGATION PATH. Notes: Whether all areas of component are accessible in a Wheelchair. Notes: Nature of covering of NAVIGATION PATH. Notes: Origin end of NAVIGATION PATH. Only needed if detailed PATH LINKs are not given. Notes: Whether element is within a gated area. Notes: Identifier of a NAVIGATION PATH. Notes: How element is lit. Notes: Type of NAVIGATION PATH. Notes: Number of people that can be in component at a time. Notes: Whether PATH is for PUBLIC use. Notes: Destination end of NAVIGATION PATH. Only needed if detailed PATH LINKs are not given. Notes: Time it takes to traverse a NAVIGATION PATH. May be derived from summing individual PATH LINK durations." ;
    tm:definitionSource "transmodel-v6.0-html" ;
    tm:module "part-1-common-concepts-cc" ;
    tm:packagePath "Transmodel v6.2  2024 / Part 1 - Common Concepts (CC) / CC Glossary TM" ;
    tm:xmiId "EAID_7145E6DD_1631_4e6f_8E7D_C59D76528EE7" .

